# Public address of the site, no trailing slash. Must be final before NFC tags are written.
NEXT_PUBLIC_SITE_URL=https://example.org

# Supabase: contact and join submissions are saved to the contact_messages and join_requests tables.
# Project Settings -> API: the project URL and the publishable key (sb_publishable_...). Insert-only by design (RLS).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional email notification for every submission (works alongside Supabase or on its own).
# Where contact and join requests are emailed (the chapter inbox).
MAIL_TO=ies.2026.hu@gmail.com
# Sender address; defaults to SMTP_USER.
MAIL_FROM=

# SMTP account used to send the emails. With Gmail: smtp.gmail.com, port 465,
# the Gmail address as SMTP_USER and an App Password (not the normal password) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ies.2026.hu@gmail.com
SMTP_PASS=

# Local testing only: 1 = accept forms and log instead of sending email.
MAIL_DRY_RUN=
