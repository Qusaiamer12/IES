{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "shortName": {
      "type": "string",
      "minLength": 1,
      "description": "Short name used in titles and the header, e.g. \"IEEE IES HU\"."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Full official name of the chapter."
    },
    "slogan": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One or two sentences for search engines and link previews."
    },
    "founded": {
      "type": "integer",
      "minimum": 2026,
      "maximum": 9007199254740991
    },
    "currentTerm": {
      "type": "string",
      "pattern": "^\\d{4}\\/\\d{4}$",
      "description": "The term shown on the team page and member pages. Must match a term in committees.json once its committee is announced."
    },
    "email": {
      "anyOf": [
        {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Public chapter email (shown on the contact page and footer). null hides it."
    },
    "address": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "One line per array item."
    },
    "mapsUrl": {
      "type": "string",
      "format": "uri"
    },
    "social": {
      "type": "object",
      "properties": {
        "instagram": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "linkedin": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "facebook": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instagram",
        "linkedin",
        "facebook"
      ],
      "additionalProperties": false,
      "description": "Chapter accounts. null hides a network."
    },
    "instagramHandle": {
      "type": "string",
      "pattern": "^@[\\w.]+$"
    }
  },
  "required": [
    "shortName",
    "name",
    "slogan",
    "description",
    "founded",
    "currentTerm",
    "email",
    "address",
    "mapsUrl",
    "social",
    "instagramHandle"
  ],
  "additionalProperties": false
}
