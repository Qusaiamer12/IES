{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "logo": {
        "type": "string",
        "pattern": "^\\/[A-Za-z0-9._/-]+\\.(?:jpe?g|png|webp|svg)$",
        "description": "In public/images/partners/."
      },
      "width": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "height": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "url": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "name",
      "logo",
      "width",
      "height"
    ],
    "additionalProperties": false
  },
  "description": "Partners of the IEEE HU Student Branch."
}
