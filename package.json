{
  "name": "ies-hu-site",
  "version": "1.0.0",
  "private": true,
  "description": "Website of the IEEE IES Student Chapter at the Hashemite University",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "preview:html": "node scripts/snapshot.mjs preview",
    "build:static": "node scripts/build-static.mjs",
    "test": "vitest run",
    "content:check": "vitest run tests/unit/content.test.ts",
    "content:schemas": "UPDATE_SCHEMAS=1 vitest run tests/unit/schemas.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "15.5.25",
    "nodemailer": "7.0.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
